{
  "cleanUrls": true,
  "functions": {
    "api/*.py": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/chat/stream", "destination": "/api" },
    { "source": "/api/chat", "destination": "/api" },
    { "source": "/api/history", "destination": "/api" },
    { "source": "/api/health", "destination": "/api" },
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/home", "destination": "/main" },
    { "source": "/landing", "destination": "/main" },
    { "source": "/dashboard", "destination": "/public" },
    { "source": "/dashboard/(.*)", "destination": "/public" },
    { "source": "/user/dashboard", "destination": "/public" },
    { "source": "/public/dashboard", "destination": "/public" },
    { "source": "/public", "destination": "/public" },
    { "source": "/trainee", "destination": "/public" },
    { "source": "/admin/dashboard", "destination": "/admin" },
    { "source": "/admin/dashboard/(.*)", "destination": "/admin" },
    { "source": "/admin", "destination": "/admin" },
    { "source": "/login", "destination": "/login" },
    { "source": "/signup", "destination": "/login" }
  ]
}

