{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/chat/stream", "destination": "/api" },
    { "source": "/api/chat", "destination": "/api" },
    { "source": "/api/history", "destination": "/api" },
    { "source": "/api/health", "destination": "/api" },
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/", "destination": "/main.html" },
    { "source": "/home", "destination": "/main.html" },
    { "source": "/main", "destination": "/main.html" },
    { "source": "/landing", "destination": "/main.html" },
    { "source": "/dashboard", "destination": "/public.html" },
    { "source": "/user/dashboard", "destination": "/public.html" },
    { "source": "/public/dashboard", "destination": "/public.html" },
    { "source": "/public", "destination": "/public.html" },
    { "source": "/trainee", "destination": "/public.html" },
    { "source": "/admin/dashboard", "destination": "/admin.html" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/login", "destination": "/login.html" },
    { "source": "/signup", "destination": "/login.html" }
  ]
}

